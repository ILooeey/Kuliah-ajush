      "id": "4e371599-e931-4e37-a4d9-150a890e1f10",
      "cell_type": "code",
      "source": "import java.util.LinkedList; \r\n\r\nLinkedList<Integer> listAngka = new LinkedList<>();\r\nlistAngka.add(5);\r\nlistAngka.add(19);\r\nlistAngka.add(44); \r\nlistAngka.add(60); \r\nlistAngka.add(31);\r\n\r\nSystem.out.println(\"Isi LinkedList: \" + listAngka);",
